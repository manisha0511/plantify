# ============================================================================
# Plantify Frontend Environment Configuration Template
# ============================================================================
# Copy this file to '.env' to configure local environment variables.
# Vite only exposes variables prefixed with 'VITE_' to the browser client.
#
# SECURITY WARNING:
# NEVER put private API secrets, payment credentials, or database passwords in this file.
# Any variable prefixed with VITE_ is bundled into client JavaScript and is publicly visible!
# In Phase 3, private API secrets will be managed securely inside our Spring Boot backend.
# ============================================================================

# Default Botanical Data Provider ('inaturalist' | 'perenual' | 'curated')
VITE_PLANT_DATA_PROVIDER=inaturalist

# Optional: Perenual API Key (Free tier from https://perenual.com/docs/api)
# If left blank, Plantify automatically uses the open, CORS-enabled iNaturalist API.
VITE_PERENUAL_API_KEY=
